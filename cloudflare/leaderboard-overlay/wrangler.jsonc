{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rudys-cutter-leaderboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-24",
  "preview_urls": false,
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "LEADERBOARD_BUCKET",
      "bucket_name": "rudys-cutter-leaderboard"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
